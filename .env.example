# VIDA NEST Environment Variables Template
# Salin file ini menjadi .env.local dan sesuaikan nilainya:
# cp .env.example .env.local

# Nomor WhatsApp tujuan pemesanan (format internasional tanpa tanda +, contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=628xxxxxxxxxx

# URL website utama (digunakan untuk Canonical URL, OpenGraph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
